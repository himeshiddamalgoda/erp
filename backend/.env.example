PORT=4000
FRONTEND_URL=http://localhost:3000

# Docker MySQL configuration. Replace these passwords before starting.
MYSQL_DATABASE=erp
MYSQL_USER=erp
MYSQL_PASSWORD=change_this_app_password
MYSQL_ROOT_PASSWORD=change_this_root_password
# Localhost port for database tools; containers always use mysql:3306.
MYSQL_PORT=3306

# Fixed development principal only; production must keep this false.
DEV_AUTH_ENABLED=false
DEV_ACTOR=sales
COMPANY_TIMEZONE=Asia/Colombo
COMPANY_NAME=Garment ERP
# Optional isolated test database. Must differ from DB_NAME/MYSQL_DATABASE and end in _test.
# TEST_DB_NAME=erp_quotation_test

# POC master country allowlist; expand for your buyer/address countries.
COMPANY_COUNTRIES=US,LK,GB,DE,FR,IN,BD,CN,PK,VN,AU,CA

# Customers migration ONLY: existing active Admin UUID for explicitly attributing
# schema adoption when legacy creator/archive actor metadata is unknown.
# This does not assert who historically created the buyer. See docs/customers.md.
# CUSTOMER_MIGRATION_ACTOR_ID=10000000-0000-4000-8000-000000000003
# For reviewed legacy Archived records missing a reason only:
# CUSTOMER_LEGACY_ARCHIVE_REASON=Explicit reason approved during legacy adoption

# Sales Teams verification uses another isolated database; no new credentials needed.
# TEST_DB_NAME=erp_sales_teams_test
# Migration006 deliberately leaves unknown legacy team/member provenance NULL.
