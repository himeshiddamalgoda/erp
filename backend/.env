PORT=4000
FRONTEND_URL=http://localhost:3000

# Docker MySQL configuration. Replace these passwords before starting.
MYSQL_DATABASE=erp
MYSQL_USER=erp
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
# Localhost port for database tools; containers always use mysql:3306.
MYSQL_PORT=3306

DEV_AUTH_ENABLED=true
DEV_ACTOR=sales

# NODE_ENV=development 
# PORT=4101 
# DEV_AUTH_ENABLED=true 
# DEV_ACTOR=manager

# Local development: required when DEV_AUTH_ENABLED=true.
NODE_ENV=development
