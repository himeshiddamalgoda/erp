{
  "name": "erp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-concurrency=1",
    "migrate": "node src/db/migrate.js",
    "migrate:down": "node src/db/migrate.js down",
    "seed": "node src/db/seeders/demo.js",
    "expire": "node src/jobs/expire-quotations.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "demo": "node scripts/quotation-demo.js",
    "docs": "node scripts/generate-openapi.js",
    "seed:orders": "node src/db/seeders/sales-orders-demo.js",
    "demo:orders": "node scripts/sales-orders-demo.js",
    "demo:fulfilment": "node scripts/sales-order-fulfilment-demo.js",
    "docs:orders": "node scripts/generate-sales-orders-openapi.js",
    "seed:customers": "node src/db/seeders/customers-demo.js",
    "docs:customers": "node scripts/generate-customers-openapi.js",
    "demo:customers": "node scripts/customers-demo.js",
    "seed:teams": "node src/db/seeders/sales-teams-demo.js",
    "docs:teams": "node scripts/generate-sales-teams-openapi.js",
    "demo:teams": "node scripts/sales-teams-demo.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "mysql2": "^3.24.6",
    "pdfkit": "^0.20.2",
    "sequelize": "^6.37.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
